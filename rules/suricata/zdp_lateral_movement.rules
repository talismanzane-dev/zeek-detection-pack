# zdp 0.1.0 | detector: lateral_movement | config: 1b5f4d413abb
# Fidelity tiers: full = equivalent to the Python detector; approx = weaker
# sub-signal; companion = pre-filter to run alongside zdp. See docs/export_fidelity.md.

# [approx] lateral_movement/admin_share_connect (sid 1326656)
#   Marks SMB flows that connected to ADMIN$/C$/drive shares; does not alert.
alert smb $HOME_NET any -> $HOME_NET any (msg:"ZDP lateral_movement admin share tree connect (flowbit setter)"; flow:to_server,established; smb.share; pcre:"/\x5c(ADMIN|[A-Z])\x24$/i"; flowbits:set,zdp.lateral.admin_share; flowbits:noalert; classtype:policy-violation; metadata:zdp_detector lateral_movement, zdp_signal admin_share_connect, zdp_tier approx, zdp_rule_id c2388104-ca39-5df6-b2e4-32b6455556c0, zdp_config_hash 1b5f4d413abb, mitre_technique_id T1021.002, mitre_tactic_id TA0008; sid:1326656; rev:1;)

# [approx] lateral_movement/admin_share_exec_transfer (sid 1198667)
#   Same-flow heuristic; Suricata cannot bind a file to the tree it was written to.
alert smb $HOME_NET any -> $HOME_NET any (msg:"ZDP lateral_movement [approx] executable/script transferred over SMB after admin share connect"; flow:to_server,established; flowbits:isset,zdp.lateral.admin_share; file.name; pcre:"/\.(exe|dll|ps1|bat|vbs|sct)$/i"; classtype:trojan-activity; metadata:zdp_detector lateral_movement, zdp_signal admin_share_exec_transfer, zdp_tier approx, zdp_rule_id a3d97664-695a-5664-a072-0a58dbcac0cb, zdp_config_hash 1b5f4d413abb, mitre_technique_id T1021.002, mitre_tactic_id TA0008; sid:1198667; rev:1;)

# [approx] lateral_movement/fanout (sid 1720310)
#   Counts SYNs, not distinct targets; cannot separate scan from access.
alert tcp $HOME_NET any -> $HOME_NET [445,135,3389,5985,5986,22] (msg:"ZDP lateral_movement [approx] >= 20 admin-port session attempts from one host within 600s"; flow:to_server,not_established; flags:S,CE; threshold:type both, track by_src, count 20, seconds 600; classtype:network-scan; metadata:zdp_detector lateral_movement, zdp_signal fanout, zdp_tier approx, zdp_rule_id 04a1010b-b74d-5ac1-a2e5-76575f1ef8f6, zdp_config_hash 1b5f4d413abb, mitre_technique_id T1021, mitre_tactic_id TA0008; sid:1720310; rev:1;)
