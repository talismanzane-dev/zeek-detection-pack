# [approx] dns_tunneling/long_query (sid 1581590)
#   Per-source rate only; no registered-domain grouping or entropy.
alert dns $HOME_NET any -> any any (msg:"ZDP dns_tunneling [approx] >= 30 long DNS query names (>= 80 chars) from one host within 3600s"; flow:to_server; dns.query; pcre:"/^.{80,}$/"; content:!".arpa"; endswith; pcre:!"/(^|\x2e)_/"; threshold:type both, track by_src, count 30, seconds 3600; classtype:policy-violation; metadata:zdp_detector dns_tunneling, zdp_signal long_query, zdp_tier approx, zdp_rule_id a4b51fde-ad70-5b23-bc4b-d654ebbdb096, zdp_config_hash cc337f5a8e7b, mitre_technique_id T1071.004, mitre_tactic_id TA0011; sid:1581590; rev:1;)

