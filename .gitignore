# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
.python-version
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- macOS ----------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Editors --------------------------------------------------------------
.idea/
.vscode/
*.swp

# --- Data and captures (never commit production traffic) -------------------
# data/ holds local datasets (e.g. CTU-13). The package's bundled reference
# data and the test data are re-included explicitly.
data/
!zdp/data/
!tests/data/
*.pcap
*.pcapng
*.log
*.log.gz
# Zeek fixture logs are synthetic and deterministic; they ARE committed.
!fixtures/**/*.log
!tests/data/**/*.log

# --- Runtime output -------------------------------------------------------
# Metrics and per-detector reports exist only as harness output (see
# docs/tuning.md). Only the hand-maintained files below are tracked.
metrics.json
out/
lab/
reports/*
!reports/README.md
!reports/false_positives.md
*.db
*.sqlite

# pcaps/ is user-supplied; the demo pcap is generated by `make lab-demo`.
pcaps/*
!pcaps/README.md
